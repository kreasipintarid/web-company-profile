<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|PROJECT_STATUS\.md) - [F,L]

    # Redirect to public folder if accessed from root
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
