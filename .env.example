# -----------------------------------------------------------------------------
# Dynamic Company Profile CMS Environment Configuration
# Salin file ini menjadi .env pada instalasi XAMPP lokal Anda
# -----------------------------------------------------------------------------

# Application
APP_NAME="PT Kreasi Solusi Nusantara"
APP_ENV="local"
APP_KEY="base64:GENERATE_RANDOM_32_CHAR_SECRET_KEY_HERE"
APP_DEBUG=true
APP_URL="http://localhost/company-profile-cms/public"
DEFAULT_LOCALE="id"
SUPPORTED_LOCALES="id,en"

# Database MySQL / MariaDB (XAMPP Default)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="db_company_profile"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"

# Zoho Mail SMTP Configuration
SMTP_HOST="smtp.zoho.com"
SMTP_PORT=587
SMTP_ENCRYPTION="tls"
SMTP_USERNAME="info@yourcompany.com"
SMTP_PASSWORD="YOUR_ZOHO_APP_PASSWORD"
MAIL_FROM="info@yourcompany.com"
MAIL_FROM_NAME="PT Kreasi Solusi Nusantara"

# Security & CAPTCHA (Cloudflare Turnstile or Google reCAPTCHA)
CAPTCHA_ENABLED=true
CAPTCHA_DRIVER="turnstile"
CAPTCHA_SITE_KEY="YOUR_CAPTCHA_SITE_KEY"
CAPTCHA_SECRET_KEY="YOUR_CAPTCHA_SECRET_KEY"

# Session & Rate Limiting
SESSION_LIFETIME=7200
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_CONTACT_MAX=3
RATE_LIMIT_CONTACT_WINDOW=300
